{
  "name": "excel-formula-formatter",
  "version": "1.0.0",
  "description": "Excel add-in that beautifies and minifies formulas in the selected cell, powered by excelFormulaUtilitiesJS.",
  "license": "MIT",
  "private": true,
  "config": {
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "typecheck": "tsc --noEmit",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@types/office-js": "^1.0.377",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-debugging": "^5.1.6",
    "office-addin-dev-certs": "^1.13.4",
    "office-addin-manifest": "^1.13.6",
    "typescript": "^5.4.5",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
